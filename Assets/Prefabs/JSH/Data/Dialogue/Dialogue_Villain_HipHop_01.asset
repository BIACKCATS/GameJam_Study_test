  m_Script: {fileID: 11500000, guid: 4077a66a6a6c7d34186db62317c0cd8a, type: 3}
  m_Name: Dialogue_Villain_HipHop_01
  m_EditorClassIdentifier: Assembly-CSharp::JSH.Data.DialogueData
  _nodes:
  - _speaker: 
    _text: "\uC624 \uC608 \uBE0C\uB85C\u2606 \uC640\uC379~"
    _choices:
    - _text: "\uC9C0\uAE08 \uD799\uD569\uC744 \uD06C\uAC8C \uD2C0\uACE0 \uACC4\uC138\uC694."
      _nextNode: 1
      _effect: 0
    - _text: "\uC9C0\uD558\uCCA0\uC5D0\uC11C \uACF5\uC5F0\uC744 \uD558\uBA74, \uC138\uAE08\uC744
        \uB0B4\uC57C\uC9C0!"
      _nextNode: 2
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: "\uC3D8\uB9AC? \uC544\uC774 \uCE94 \uD788\uC5BC \uC720. \uB9C8 \uBE0C\uB85C.
      \uC608~"
    _choices:
    - _text: You are interfering with our business operations right now.
      _nextNode: 3
      _effect: 0
    - _text: "\uC7A0\uB9CC. \uC774\uAC74 \uCF69\uAE00\uB9AC\uC2DC\uC796\uC544!"
      _nextNode: 4
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: "\uC624\uB9C8\uAC13 \uBE0C\uB85C, \uC138\uAE08\uC774\uB77C\uB2C8. \uC5EC\uAE34
      \uC4F0\uAEC4\u3139\u3139\u2606\uD55C \uC6B0\uB9AC \uAD6C\uC5ED\uC774\uB77C\uACE0?"
    _choices:
    - _text: "\uADF8\uB807\uB2E4\uBA74 \uB2F9\uC7A5 \uC774 \uC790\uB9AC\uC5D0\uC11C
        \uBC29 \uBE7C. \uC5EC\uAE34 \uB0B4 \uAD6C\uC5ED\uC774\uB2E4."
      _nextNode: 5
      _effect: 0
    - _text: "\uC4F0\uAEC4\uD558\uAE30\uC5D4, \uB108\uBB34 \uC5B4\uB450\uCEF4\uCEF4\uD558\uACE0
        \uC0AC\uB78C\uB3C4 \uC5C6\uC9C0 \uC54A\uC544?"
      _nextNode: 6
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: "\uC653....? \uC5C4. \uC608? \uC5B4?"
    _choices:
    - _text: we can exposing you to imminent civil and criminal litigation
      _nextNode: 7
      _effect: 0
    - _text: "\uB108 \uC601\uC5B4 \uBABB\uD558\uC9C0."
      _nextNode: 8
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: "\uC820\uC7A5 \uB4E4\uCF30\uB2E4. \uB098 \uC0AC\uB098\uC774 \uC870\uB098\uB2E8!
      \uC5B4\uB5BB\uAC8C\uB4E0 \uD799\uD569\uC73C\uB85C!"
    _choices: []
    _nextNode: -1
    _outcome: 2
  - _speaker: 
    _text: "\uBB50? \uB124 \uAD6C\uC5ED\uC774\uC5C8\uB2E4\uACE0? \uC820\uC7A5 \uBAB0\uB790\uAD70
      \uC0AC\uC8C4\uD558\uC9C0."
    _choices: []
    _nextNode: -1
    _outcome: 1
  - _speaker: 
    _text: "\uC74C....\uD655\uC2E4\uD788 \uC5B4\uB450\uCEF4\uCEF4\uD558\uACE0, \uC0AC\uB78C\uB3C4
      \uC5C6\uC5B4 \uC774\uAC8C \uBC14\uB85C \uD6C4\uB4DC\uB77C\uB294 \uAC83!"
    _choices: []
    _nextNode: -1
    _outcome: 2
  - _speaker: 
    _text: "\uC804\uB7B5\uC801 \uD6C4\uD1F4\uB2E4!!"
    _choices: []
    _nextNode: -1
    _outcome: 1
  - _speaker: 
    _text: "\uAC13 \uB310 \uBE0C\uB85C! \uB2F9\uC5F0\uD558\uC9C0 \uC54A\uC544? \uC774
      \uC870 \uB098\uB2E8\uC740 \uD55C\uAD6D\uC778\uC774\uB77C\uACE0? \uD799\uD569\uC5D0\uB294
      \uAD6D\uAC00\uAC00 N\u2606O\u2606N\u2606E!"
    _choices:
    - _text: "\uC880 \uADF8\uB7FC \uC870\uC6A9\uD788 \uD574\uC8FC\uC2DC\uACA0\uC5B4\uC694?
        \uACE0\uAC1D\uB2D8\uB4E4\uC774 \uD53C\uD574\uB97C \uBC1B\uACE0 \uC788\uC5B4\uC694."
      _nextNode: 9
      _effect: 0
    - _text: "\uAD6D\uAC00\uAC00 \uC5C6\uC73C\uBA74 \uB354 \uB113\uC740 \uACF3\uC73C\uB85C
        \uAC00\uB294\uAC8C \uC5B4\uB54C\uC694?"
      _nextNode: 10
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: "\uBB63... \uADF8\uAC74 \uD799\uD558\uC9C0 \uC54A\uC740\uB370. \uC54C\uACA0\uC2B5\uB2C8\uB2E4.
      \uC8FC\uC758\uD560\uAC8C\uC694."
    _choices: []
    _nextNode: -1
    _outcome: 1
  - _speaker: 
    _text: "\uC624 \uB098\uC058\uC9C0 \uC54A\uC740 \uC120\uD0DD\uC774\uC57C. \uADF8\uB7FC
      \uD799\uD569\uC744 \uB3CC\uB824\uBCF4\uB294\uAC70\uC57C!"
    _choices: []
    _nextNode: -1
    _outcome: 2
