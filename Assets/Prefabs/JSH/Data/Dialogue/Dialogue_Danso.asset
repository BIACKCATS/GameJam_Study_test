MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4077a66a6a6c7d34186db62317c0cd8a, type: 3}
  m_Name: Dialogue_Danso
  m_EditorClassIdentifier: Assembly-CSharp::JSH.Data.DialogueData
  _nodes:
  - _speaker: 
    _text: "\uBB50\uC2DC\uC5EC? \uC9C0\uAE08 \uBB50 \uD558\uB294\uAC70\uC57C?"
    _choices:
    - _text: "\uC548\uB155\uD558\uC138\uC694 \uC5B4\uB974\uC2E0."
      _nextNode: 1
      _effect: 0
    - _text: "\uC73D \uC220 \uB0C4\uC0C8... \uC544\uB2D9\uB2C8\uB2E4."
      _nextNode: 2
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: "\uB108\uAC00 \uB204\uAD70\uB370? \uD6C4 \uC544 \uC720!"
    _choices:
    - _text: "\uC9C0\uD558\uCCA0 \uACF5\uC775 \uC694\uC6D0 \uBC15\uD574\uCCA0\uC785\uB2C8\uB2E4."
      _nextNode: 3
      _effect: 0
    - _text: "\uC5B4... \uADF8, \uB2E8\uC18C\uB97C \uC5C4\uCCAD \uC798 \uBD80\uB974\uC2E4
        \uAC83 \uAC19\uC544\uC11C\uC694."
      _nextNode: 4
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: "\uBB50? \uB108 \uC9C0\uAE08 \uC7A5\uB09C\uCE58\uB098?"
    _choices:
    - _text: "\uB2E8\uC18C\uB97C \uB4E4\uACE0 \uB4E4\uC5B4\uC628 \uC120\uC0DD\uB2D8\uAED8\uC11C
        \uD558\uC2E4 \uB9D0\uC500\uC740 \uC544\uB2CC \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
      _nextNode: 5
      _effect: 0
    - _text: "\uB2E4\uB978 \uACE0\uAC1D\uB2D8\uB4E4\uAED8\uC11C \uBD88\uC548\uD574\uD558\uC2ED\uB2C8\uB2E4."
      _nextNode: 6
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: "\uADF8\uB7EC\uB0D0? \uBB34\uC2A8 \uC77C\uC778\uB370"
    _choices:
    - _text: "\uBB38\uC758 \uC2E0\uACE0\uAC00 \uB4E4\uC5B4\uC640\uC11C \uC654\uC2B5\uB2C8\uB2E4"
      _nextNode: 7
      _effect: 0
    - _text: "\uB2E8\uC18C\uAC00 \uADF8\uC800 \uC544\uB984\uB2E4\uC6CC\uC11C..."
      _nextNode: 8
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: "\uB2E8\uC18C? \uD558 \uCC38! \uC774\uAC70 \uBB34\uAE30\uC57C!"
    _choices:
    - _text: "\uC800 \uC5EC\uAE30 112 \uC2E0\uACE0 \uD588\uC73C\uB2C8\uAE4C \uC804\uBD80
        \uB2E4..."
      _nextNode: 9
      _effect: 0
    - _text: "\uC544\uD558. \uBB34\uAE30\uAD70\uC694. \uD558\uC9C0\uB9CC \uBB34\uAE30\uB294
        \uD604\uC7AC \uB9C8\uAD6C \uD718\uB450\uB974\uC2DC\uBA74 \uBC95\uC801\uC778
        \uBB38\uC81C\uAC00 \uBC1C\uC0DD\uD569\uB2C8\uB2E4."
      _nextNode: 10
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: "\uCF71 \uC528 \uB0B4\uAC00 \uB54C\uB838\uB098? \uB098 \uC548\uB54C\uB838\uC5B4!"
    _choices:
    - _text: "\uADF8 \uB09C\uB3D9\uC740 \uBD80\uB9AC\uC2E0\uAC8C \uB9DE\uC73C\uC2DC\uC796\uC544\uC694..."
      _nextNode: 11
      _effect: 0
    - _text: "\uD760... \uADFC\uB370 \uC0AC\uB78C\uB4E4\uC774 \uB108\uBB34 \uBB34\uC11C\uC6CC
        \uD558\uC2DC\uB294 \uAC83 \uAC19\uC544\uC694."
      _nextNode: 12
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: "\uBB50? \uADF8\uAC8C \uBB34\uC2A8 \uC54C\uBC18\uB370?"
    _choices: []
    _nextNode: -1
    _outcome: 2
  - _speaker: 
    _text: "\uBB50...\uB098 \uC544\uBB34\uAC83\uB3C4 \uC548\uD588\uC5B4! \uC548\uD574!"
    _choices: []
    _nextNode: -1
    _outcome: 1
  - _speaker: 
    _text: "<angry>\uC7A5\uB09C\uC744 \uCCD0? \uC8FD\uACE0 \uC2F6\uC5B4!</angry>"
    _choices: []
    _nextNode: -1
    _outcome: 2
  - _speaker: 
    _text: "\uBB50? \uC9C0\uAE08 \uC544\uBB34\uAC83\uB3C4 \uC548\uD55C \uC2DC\uBBFC\uC744
      \uC2E0\uACE0\uD588\uB2E4\uB294\uAC70\uB0D0!"
    _choices: []
    _nextNode: -1
    _outcome: 2
  - _speaker: 
    _text: "\uC548 \uD718\uB458\uB800\uC5B4! \uC548 \uB2E4\uCCE4\uC5B4! \uB410\uC9C0!
      \uC548 \uD718\uB450\uB978\uB2E4! \uC2E0\uACE0\uD558\uC9C0\uB9C8\uB77C!"
    _choices: []
    _nextNode: -1
    _outcome: 1
  - _speaker: 
    _text: "<angry>\uC5B4\uCA4C\uB77C\uACE0! \uC2DC\uB044\uB7EC\uC6B4 \uB140\uC11D\uC774!</angry>"
    _choices: []
    _nextNode: -1
    _outcome: 2
  - _speaker: 
    _text: "\uBB50? \uBB50\uAC00 \uBB50\uB97C \uBB34\uC11C\uC6CC\uD55C\uB2E4\uACE0.
      \uADF8\uC800 \uB2E8\uC190\uB370."
    _choices: []
    _nextNode: -1
    _outcome: 1
