--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4077a66a6a6c7d34186db62317c0cd8a, type: 3}
  m_Name: Dialogue_Villain_SleepyMan_01
  m_EditorClassIdentifier: Assembly-CSharp::JSH.Data.DialogueData
  _nodes:
  - _speaker: 
    _text: "\uCFE8...."
    _choices:
    - _text: "\uACE0\uAC1D\uB2D8... \uC774 \uACF3\uC5D0\uC11C \uC8FC\uBB34\uC2DC\uBA74
        \uC785 \uB3CC\uC544\uAC00\uC138\uC694..."
      _nextNode: 1
      _effect: 0
    - _text: "\uD558. \uBB3C \uC5B4\uB528\uB0D0. \uBB3C\uBD80\uD130 \uBFCC\uB824\uC57C\uACA0\uB2E4.
        \uC18C\uAE08\uB3C4 \uAC19\uC774"
      _nextNode: 2
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: "\uCFE8\uCFE8..."
    _choices:
    - _text: "\uC544\uC6B0 \uC548\uC77C\uC5B4\uB098\uC2DC\uB124. \uC57C. \uC57C.
        \uC77C\uC5B4\uB098. \uC77C\uC5B4\uB098\uC138\uC694!"
      _nextNode: 3
      _effect: 0
    - _text: "\uC548\uC77C\uC5B4\uB098\uC2DC\uBA74 \uACBD\uCC30 \uBD80\uB985\uB2C8\uB2E4...?"
      _nextNode: 4
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: "\uBB50? \uBB3C \uBFCC\uB9B0\uB2E4\uACE0? \uC18C\uAE08\uB3C4? \uCEAD \uD264
      \uC9C0\uAE08 \uBB50\uD558\uB294 \uC9D3\uC774\uC57C!"
    _choices:
    - _text: "\uBB3C\uACFC \uBBF8\uB124\uB784\uC744 \uB4DC\uB824\uC11C \uC0DD\uAE30\uB97C
        \uCC28\uB9B4 \uC218 \uC788\uAC8C \uB3C4\uC640\uB4DC\uB9AC\uB824 \uD588\uB2E4."
      _nextNode: 5
      _effect: 0
    - _text: "\uC560\uCD08\uC5D0 \uC5EC\uAE30\uB294 \uB2F9\uC2E0\uC758 \uCE68\uB300\uAC00
        \uC544\uB2CC\uAC78\uC694."
      _nextNode: 6
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: "\uC5B4\uC73C...\uCCAD\uB144... \uB0B4 \uBBF8\uC548\uD574...\uC7A0\uC744
      \uC5EC\uD0DC \uBABB\uC7A4\uC5B4..."
    _choices:
    - _text: "\uADF8\uB798\uB3C4 \uADF8 \uC790\uB9AC\uB294 \uC0AC\uB78C\uB4E4\uC774
        \uC11C\uC788\uB294 \uC790\uB9AC\uC785\uB2C8\uB2E4."
      _nextNode: 7
      _effect: 0
    - _text: "\uB2F9\uC2E0\uB9CC \uBABB\uC7A4\uC5B4? \uB2E4\uB4E4 \uACE0\uC0DD\uD558\uB294\uAC70
        \uC548\uBCF4\uC5EC?"
      _nextNode: 8
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: "...\uBB50? \uACBD\uCC30? \uBB34\uC2A8 \uACBD\uCC30. \uC790\uB294\uAC78\uB85C
      \uACBD\uCC30\uC744 \uBD88\uB7EC?"
    _choices:
    - _text: "\uBB50\uC57C \uC790\uB358\uAC70\uB3C4 \uC544\uB2C8\uC5C8\uC5B4?"
      _nextNode: 9
      _effect: 0
    - _text: "\uACE0\uAC1D\uB2D8\uAED8\uC11C \uB204\uC6CC\uACC4\uC154\uC11C \uB2E4\uB978
        \uACE0\uAC1D\uB2D8\uB4E4\uC774 \uD0D1\uC2B9\uC5D0 \uBD88\uD3B8\uC744 \uACAA\uACE0
        \uC788\uC2B5\uB2C8\uB2E4."
      _nextNode: 10
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: "\uB098\uB791 \uC9C0\uAE08 \uC7A5\uB09C\uD574? \uB0B4\uAC00 \uB204\uAD70\uC9C0
      \uC54C\uC544! \uD658\uBD88\uD574! \uB2F9\uC7A5!"
    _choices: []
    _nextNode: -1
    _outcome: 2
  - _speaker: 
    _text: "\uB0B4 \uBAA8\uB97C\uB9AC\uAC00 \uC788\uB098. \uADF8\uB798\uB3C4 \uB9D0\uC77C\uC138.
      \uD53C\uACE4\uD558\uBA74, \uC790\uB9AC\uB3C4 \uB0A8\uC544\uC788\uB294\uB370...
      \uD65C\uC6A9\uD560 \uC218\uB3C4 \uC788\uB294\uAC70\uC9C0."
    _choices:
    - _text: "\uADF8\uAC70 \uB0A8\uC758 \uC2E0\uBC1C\uBC14\uB2E5\uC774 \uB2FF\uB358
        \uACF3\uC785\uB2C8\uB2E4."
      _nextNode: 11
      _effect: 0
    - _text: "\uD65C\uC6A9\uC758 \uAE30\uC900\uC774 \uB0A8\uB2E4\uB974\uC2ED\uB2C8\uB2E4.
        \uADFC\uB370 \uC774\uBC88\uC5D4 \uC880 \uC790\uC81C\uD574\uBCF4\uC2DC\uB294\uAC8C
        \uC5B4\uB5A0\uC2E4\uAE4C\uC694."
      _nextNode: 12
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: "\uB0B4 \uAF2C\uB9AC\uBF08\uC5D0 \uAE08\uC774 \uAC00\uC788\uC5B4\uC11C
      \uD3B8\uD788 \uC549\uC544 \uAC08 \uC218 \uC5C6\uB124.. \uBB34\uB98E\uB3C4 \uC2DC\uB824..."
    _choices: []
    _nextNode: -1
    _outcome: 1
  - _speaker: 
    _text: "\uBB50\uB77C\uACE0? \uC9C0\uAE08 \uB108 \uBC18\uB9D0\uC774\uB0D0? \uB108
      \uB2F4\uB2F9 \uB204\uAD6C\uC57C!"
    _choices: []
    _nextNode: -1
    _outcome: 2
  - _speaker: 
    _text: "\uC790\uB294\uAC70 \uC544\uB2C8\uC5C8\uC5B4\uB294 \uBC18\uB9D0\uC774\uACE0
      \uC774 \uC790\uC2A5\uB188\uC544!"
    _choices: []
    _nextNode: -1
    _outcome: 2
  - _speaker: 
    _text: "\uC5C9...? \uC5B4.\uD06C...\uD760.....\uC74C. \uBC14\uB974\uAC8C \uAC00\uACA0\uB124..."
    _choices: []
    _nextNode: -1
    _outcome: 1
  - _speaker: 
    _text: "\uBB50? \uC5C9\uB369\uC774? \uB2F9\uC7A5 \uBC14\uB85C \uB2E4\uC2DC \uACE0\uCE58\uACA0\uC5B4."
    _choices: []
    _nextNode: -1
    _outcome: 1
  - _speaker: 
    _text: "\uBB50 \uC774 \uC790\uC2DD\uC774...! \uC9C0\uAE08 \uC0AC\uB78C\uC744
      \uB180\uB824!"
    _choices: []
    _nextNode: -1
    _outcome: 2
