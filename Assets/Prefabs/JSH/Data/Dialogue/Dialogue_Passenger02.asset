  m_Script: {fileID: 11500000, guid: 4077a66a6a6c7d34186db62317c0cd8a, type: 3}
  m_Name: Dialogue_Passenger02
  m_EditorClassIdentifier: Assembly-CSharp::JSH.Data.DialogueData
  _nodes:
  - _speaker: 
    _text: "\uBB34\uC2A8 \uC77C\uC774\uC2DC\uC8E0?"
    _choices:
    - _text: "\uADF8 \uC790\uB9AC \uC784\uC0B0\uBD80 \uC11D\uC774\uC2ED\uB2C8\uB2E4."
      _nextNode: 1
      _effect: 0
    - _text: "\uC544. \uC8C4\uC1A1\uD569\uB2C8\uB2E4. \uB9D0 \uC798\uBABB \uAC78\uC5C8\uC2B5\uB2C8\uB2E4."
      _nextNode: 2
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: "\uC544\uC774\uACE0, \uBBF8\uC548\uD574\uC694. \uC0AC\uB78C \uC5C6\uC73C\uB2C8\uAE4C
      \uC7A0\uC2DC \uD0C0\uACE0 \uC788\uC5B4\uB3C4 \uB418\uC8E0? \uB2E4\uB9AC \uC544\uD30C\uC11C
      \uADF8\uB798\uC694"
    _choices:
    - _text: "\uBB50\uC694? \uB0B4\uB824."
      _nextNode: 3
      _effect: 0
    - _text: "\uB124 \uC549\uC544 \uACC4\uC138\uC694. \uB300\uC2E0 \uC784\uC0B0\uBD80
        \uC624\uC2DC\uBA74 \uBE44\uD0A4\uC154\uC57C\uD574\uC694."
      _nextNode: 4
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: "\uBB50? \uB108\uAC00 \uBB54\uB370!"
    _choices: []
    _nextNode: -1
    _outcome: 2
  - _speaker: 
    _text: "\uBC14\uB85C \uC0AC\uB78C \uC624\uBA74 \uC790\uB9AC \uBC14\uAFD4\uC904\uAC8C\uC694."
    _choices: []
    _nextNode: -1
    _outcome: 1
  - _speaker: 
    _text: "\uB124 \uC54C\uACA0\uC2B5\uB2C8\uB2E4"
    _choices: []
    _nextNode: -1
    _outcome: 1
