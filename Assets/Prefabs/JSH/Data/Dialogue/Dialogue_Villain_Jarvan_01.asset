  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4077a66a6a6c7d34186db62317c0cd8a, type: 3}
  m_Name: Dialogue_Villain_Jarvan_01
  m_EditorClassIdentifier: Assembly-CSharp::JSH.Data.DialogueData
  _nodes:
  - _speaker: 
    _text: ...
    _choices:
    - _text: "\uD560\uC544\uBC84\uC9C0\uB294 \uC65C \uADF8\uB807\uAC8C \uC785\uACE0
        \uB2E4\uB2C8\uC138\uC694."
      _nextNode: 1
      _effect: 0
    - _text: "\uBAA8\uC790\uAC00 \uB9E4\uC6B0 \uD06C\uC2DC\uB2C8 \uD1B5\uD589\uC5D0
        \uBC29\uD574\uAC00 \uB418\uC2DC\uC5B4 \uBC97\uC5B4 \uC8FC\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4."
      _nextNode: 2
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: ...
    _choices:
    - _text: "\uD639\uC2DC \uC800 \uBB34\uC2DC\uD558\uC2EC?"
      _nextNode: 3
      _effect: 0
    - _text: "\uADF8 \uD6C8\uC7A5\uC740 \uD639\uC2DC \uC124\uB9C8...!"
      _nextNode: 4
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: "\uC5D0\uC789 \uCBE7 \uC774 \uD6C8\uC7A5\uC744 \uC54C\uC544\uBCF4\uACA0\uB098?"
    _choices:
    - _text: "\uC5B4 \uB124? \uC8C4\uC1A1\uD569\uB2C8\uB2E4. \uBB34\uC2A8 \uD6C8\uC7A5\uC778\uB370\uC694?"
      _nextNode: 5
      _effect: 0
    - _text: "\uC798 \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4."
      _nextNode: 6
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: ...
    _choices: []
    _nextNode: -1
    _outcome: 2
  - _speaker: 
    _text: "\uC774 \uD6C8\uC7A5\uC740 \uACFC\uAC70\uC758 \uC0C1\uCC98\uC774\uC790
      \uC601\uAD11\uC2A4\uB7EC\uC6B4 \uD6C8\uC7A5\uC774\uC9C0."
    _choices: []
    _nextNode: -1
    _outcome: 1
  - _speaker: 
    _text: "\uBB34\uB824 \uACFC\uAC70 \uCC38\uC804 \uC6A9\uC0AC\uB4E4\uC5D0\uAC8C\uB9CC
      \uC8FC\uB294 \uD6C8\uC7A5\uC774\uB77C\uACE0."
    _choices:
    - _text: "\uC5C7 \uC218\uACE0\uD558\uC168\uC2B5\uB2C8\uB2E4."
      _nextNode: 7
      _effect: 0
    - _text: "\uAC10\uC0AC\uD569\uB2C8\uB2E4!"
      _nextNode: 8
      _effect: 0
    _nextNode: -1
    _outcome: 0
  - _speaker: 
    _text: "\uD639\uC2DC \uC54C\uC544\uBCF4\uC558\uB098. \uADF8\uB798. \uADF8\uB7FC
      \uC870\uC6A9\uD788 \uB118\uC5B4\uAC00\uB3C4\uB85D \uD558\uC9C0"
    _choices: []
    _nextNode: -1
    _outcome: 1
  - _speaker: 
    _text: "\uADF8\uB798. \uB9E4\uBC88 \uACE0\uC0DD\uC774 \uB9CE\uAD70 \uC80A\uC740\uC774."
    _choices: []
    _nextNode: -1
    _outcome: 1
  - _speaker: 
    _text: "\uBB58, \uADF8\uB798\uB3C4 \uD55C\uBC88 \uC6C3\uC5B4\uBCFC \uC218 \uC788\uAC8C
      \uB418\uC11C \uB2E4\uD589\uC774\uC57C."
    _choices: []
    _nextNode: -1
    _outcome: 1
